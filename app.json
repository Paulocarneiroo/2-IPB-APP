{
  "expo": {
    "name": "ipb-app-front",
    "slug": "ipb-app-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ipb-symbol.png",
    "scheme": "ipbappfront",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ipb-symbol.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paulocarneiroo.ipbappfront"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ipb-symbol.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ipb-symbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d41628c2-b17c-4737-a285-09bdc823ef3f"
      }
    }
  }
}
